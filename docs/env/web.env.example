# Supabase — Dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Serveur uniquement — ne JAMAIS préfixer par NEXT_PUBLIC_
# Utilisée par le formulaire « Proposer un événement » (Dashboard > API Keys > Secret keys)
SUPABASE_SECRET_KEY=sb_secret_...

# IA — lecture des affiches (serveur uniquement)
OPENROUTER_API_KEY=
# Facultatif : modèles choisis au banc d'essai du 14/10/2026
IA_MODELE_PRINCIPAL=anthropic/claude-haiku-5.5
IA_MODELE_SECOURS=google/gemini-3.5-flash-lite

# Site
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
REVALIDATE_SECRET=

# Sel de l'empreinte des adresses IP (anti-abus du formulaire) : une longue phrase au hasard
SEL_IP=

# Anti-spam formulaire (Cloudflare Turnstile) — Sprint 2
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
